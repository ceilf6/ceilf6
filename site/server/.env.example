# manage.py 默认以开发模式（DJANGO_DEBUG=true）零配置启动；
# WSGI / Gunicorn 生产入口默认按非调试模式（DJANGO_DEBUG=false）安全闭合运行，
# 生产环境必须显式配置高强度随机 DJANGO_SECRET_KEY（>=50 字符、至少 5 种不同字符，不得使用示例值）。

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-example-placeholder
DJANGO_ALLOWED_HOSTS=www.wangjinghong.com,127.0.0.1,localhost
SQLITE_PATH=var/db.sqlite3
DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=var/mail
DJANGO_ADMIN_PATH=admin/
ALLOW_GUEST_COMMENTS=false
