# 配置优先级：进程环境变量 > .env 文件 > 入口默认值（manage.py 默认 DJANGO_DEBUG=true，WSGI/Gunicorn 默认 DJANGO_DEBUG=false）。
# 本地开发直接执行 manage.py 即可零配置启动，无需创建 .env（默认使用受限目录 var/mail 的 filebased.EmailBackend 与 var/cache 文件缓存）。
#
# 生产环境复制本模板为 .env 后，必须显式完成以下四项配置（缺一均按 fail-closed 策略拒绝启动）：
# 1. 取消注释 DJANGO_DEBUG=false，使同一主机上的 manage.py（migrate / check --deploy）与 WSGI/Gunicorn 共享一致的生产配置；
# 2. 填写高强度随机 DJANGO_SECRET_KEY（>=50 字符、至少 5 种不同字符，且不得以 django-insecure- 开头）与 DJANGO_ALLOWED_HOSTS；
# 3. 取消注释并设置 DJANGO_TRUSTED_PROXY_COUNT（单层 Nginx 反代设为 1，CDN + Nginx 双层反代设为 2，无反代直连设为 0）；
# 4. 显式设置 DJANGO_EMAIL_BACKEND：
#    - 无外部发信服务时可显式指定 django.core.mail.backends.filebased.EmailBackend（配合受限目录 EMAIL_FILE_PATH）；
#    - 启用真实发信时指定 django.core.mail.backends.smtp.EmailBackend，并开启 465（SSL）或 587（STARTTLS）加密（禁止明文或 25 端口）。
# 单机 SQLite 生产部署建议保持单进程多线程或单 worker Gunicorn，并将 SQLITE_PATH / DJANGO_CACHE_PATH 指向可写持久目录（如 /var/lib/wangjinghong/），
# 以便跨 worker 重启共享 django-allauth 登录/注册限流计数。

# DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=www.wangjinghong.com,127.0.0.1,localhost
# DJANGO_TRUSTED_PROXY_COUNT=1
# SQLITE_PATH=var/db.sqlite3
# DJANGO_CACHE_PATH=var/cache
# DJANGO_ADMIN_PATH=admin/

# --- 邮件后端（生产环境 DJANGO_DEBUG=false 时必须显式取消注释并选择其一） ---
# 方案 A：受限本地目录落盘（便于无外部 SMTP 时审计与排查）
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=var/mail

# 方案 B：外部加密 SMTP 发信（必须开启 465 + SSL 或 587 + TLS，禁止明文或 25 端口）
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=465
# DJANGO_EMAIL_USE_SSL=true
# DJANGO_EMAIL_USE_TLS=false
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_TIMEOUT=10
# DJANGO_DEFAULT_FROM_EMAIL=noreply@wangjinghong.com
