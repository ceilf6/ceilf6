# 配置优先级：进程环境变量 > .env 文件 > 入口默认值（manage.py 默认 true，WSGI/Gunicorn 默认 false）。
# 本地开发直接执行 manage.py 即可零配置启动，无需创建 .env。
# 生产环境复制本模板为 .env 后，必须显式填写高强度随机 DJANGO_SECRET_KEY（>=50 字符、至少 5 种不同字符）与 DJANGO_ALLOWED_HOSTS；
# 未填写时 WSGI / Gunicorn 将按 fail-closed 策略拒绝启动。

# DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1,localhost
# SQLITE_PATH=var/db.sqlite3
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=var/mail
# DJANGO_ADMIN_PATH=admin/
